{
  "ci": {
    "collect": {
      "startServerCommand": "npx --yes serve@14 out -l 9321",
      "startServerReadyPattern": "Accepting connections",
      "url": [
        "http://localhost:9321/",
        "http://localhost:9321/products/",
        "http://localhost:9321/contact/"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.75
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
